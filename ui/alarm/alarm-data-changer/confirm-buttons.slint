import { ButtonText } from "@seeds-clock/ui/common-parts/button-text.slint";
export component ConfirmButtons {
	in property <float> size: 1.0;

	width: 300px * root.size;
	height: 30px * root.size;

	private property <length> button-width: 90px * root.size;
	in property <brush> base-color: #EBAB65;
	HorizontalLayout {
		alignment: space-between;
		cross-axis-alignment: center;

		delete := ButtonText {
			size: root.size;
			width: root.button-width;

			text: "Delete";
			background: root.base-color.darker(0.2);
		}
		cancel := ButtonText {
			size: root.size;
			width: root.button-width;

			text: "Cancel";
			background: root.base-color.darker(0.1);
		}
		save := ButtonText {
			size: root.size;
			width: root.button-width;

			text: "Save";
			background: root.base-color;
		}
	}
	callback delete <=> delete.clicked;
	callback cancel <=> cancel.clicked;
	callback save <=> save.clicked;
}