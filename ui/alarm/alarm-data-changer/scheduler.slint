import { TextInCircle } from "@seeds-clock/ui/alarm/alarm-bar/text-in-circle.slint";
export component Scheduler {
	in property <float> size: 1.0;

	width: 400px * root.size;
	height: 60px * root.size;

	private property <[string]> days: [
		"M", "T", "W", "T", "F", "S", "S",
	];

	in-out property <[bool]> schedule: [
		false, false, false, false, false, false, false,
	];

	in property <brush> circle-color: cyan;
	HorizontalLayout {
		alignment: space-between;
		cross-axis-alignment: center;

		for day[i] in days : TextInCircle {
			size: root.size;
			text: day;

			animate size {
				duration: 100ms;
			}

			private property <bool> enabled: root.schedule[i];
			background: root.circle-color;
				
			TouchArea {
				mouse-cursor: pointer;

				clicked => {
					if parent.enabled {
						root.schedule[i] = false;
					}
					else {
						root.schedule[i] = true;
					}
				}

				changed has-hover => {
					if self.has-hover {
						parent.size = root.size * 1.2;
					}
					else {
						parent.size = root.size;
					}
				}
			}

			Rectangle {
				background: black;
				border-radius: parent.width;

				opacity: parent.enabled ? 0.0 : 0.5;
			}
		}
	}
}