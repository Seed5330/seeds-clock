import { CommonText } from "@seeds-clock/ui/common-parts/common-text.slint";
export component FakeClock {
	width: common-text-style.width * 1.25;
	height: 36px;

	in property <brush> background <=> rectangle.background;
	rectangle := Rectangle {
		background: yellow;
	}


	in-out property <string> time-display <=> common-text-style.text;
	common-text-style := CommonText {
		text: "10hr 0min";
		font-size: root.height / 1.5;
	}

	@children
}
