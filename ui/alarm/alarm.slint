import { Common } from "@seeds-clock/ui/common.slint";

import {
	FakeTabSwitch, ColoredYScroll, TextWithBackround, TouchBlock
} from "@seeds-clock/ui/common-parts/common-parts.slint";
import {
	FakeClock, Notification, DuplicateAlarmError
} from "accessories/accessories.slint";

import { AlarmBar } from "alarm-bar/alarm-bar.slint";
import { AlarmScroll } from "alarm-scroll.slint";
import { AlarmDataChanger } from "alarm-data-changer/alarm-data-changer.slint";

import { AlarmGlobals, AlarmData } from "globals.slint";

export { AlarmGlobals, AlarmData }



export component Alarm {
	width: Common.window-width;
	height: Common.window-height;

	Rectangle { background: #F59D47; }


	fake-clock := FakeClock {
		y: 600px;

		TouchArea {
			clicked => {
				notification.toggle(true);
			}
		}
	}


	AlarmScroll {
		y: self.set-y();
		pure function set-y() -> length {
			let bar-height = 75px;
			let window-center = root.height / 2;
			let scroll-center = self.height / 2;

			(window-center - scroll-center) + (bar-height / 2)
		}

		settings(index) => {
			alarm-data-changer.set-index(index);
			alarm-data-changer.set-visible(true);
		}
	}


	TextWithBackround {
		y: 120px;
		text: "Next Alarm: 00:00";
		background: #E0704C;
		border-radius: 8px;
	}


	touch-block := TouchBlock {
		visible: false;
	}

	alarm-data-changer := AlarmDataChanger {
		visible: false;

		clicked => {
			self.set-visible(false);
			duplicate-alarm-error.toggle-off();
		}

		duplicate-error(time-display) => {
			duplicate-alarm-error.set-time-display(time-display);
		}

		function set-visible(toggle: bool) {
			if toggle {
				touch-block.set-opacity(0.5);
			}
			else {
				touch-block.set-opacity(0.0);
			}	

			self.visible = toggle;
		}
	}
	

	duplicate-alarm-error := DuplicateAlarmError {
		y: 470px;
		opacity: 0.0;
	}




	notification := Notification {
		y: -240px;

		clicked => {
			self.toggle(false);
		}

		private property <easing> easing: ease-in-quint;
		animate y {
			duration: 500ms;
			easing: self.easing;
		}

		function toggle(toggle: bool) {
			if toggle {
				self.easing = ease-out-back;
				self.y = 240px;
				touch-block.set-opacity(0.8);
			}
			else {
				self.easing = ease-in-back;
				self.y = -240px;
				notification-timer.start();
			}
		}

		notification-timer := Timer {
			running: false;
			interval: 700ms;

			triggered => {
				touch-block.set-opacity(0.0);
				self.stop()
			}
		}
	}



	fake-tab-switch := FakeTabSwitch { y: 0px; }
}
