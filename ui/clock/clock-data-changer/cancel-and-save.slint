component ButtonWithText {
	in property <float> size: 1.0;

	width: 70px * root.size;
	height: 24px * root.size;



	in property <brush> background <=> rectangle.background;
	rectangle := Rectangle {
		background: red;
	}



	in property <string> text <=> text.text;
	text := Text {
		width <=> root.width;
		height <=> root.height;

		text: "Button";
		color: touch-area.has-hover ?
			white.darker(0.5) : white;

		font-size: 16px * root.size;
		font-family: "Roboto";

		horizontal-alignment: center;
		vertical-alignment: center;

		stroke: black;
		stroke-width: 2px;



		animate color {
			duration: 200ms;
		}
	}



	callback clicked <=> touch-area.clicked;
	touch-area := TouchArea {
		mouse-cursor: pointer;
	}
}




export component CancelAndSave {
	in property <float> size: 1.0;

	width: (cancel.width * 2) + (horizontal-layout.spacing * 2.5);
	height: cancel.height;



	callback cancel <=> cancel.clicked;
	callback save <=> save.clicked;

	horizontal-layout := HorizontalLayout {
		alignment: center;

		spacing: 10px;

		padding-left: self.spacing;
		padding-right: self.spacing;



		cancel := ButtonWithText {
			size <=> root.size;
			text: "Cancel";

			background: transparent;
		}

		save := ButtonWithText {
			size <=> root.size;
			text: "Save";

			background: transparent;
		}
	}
}