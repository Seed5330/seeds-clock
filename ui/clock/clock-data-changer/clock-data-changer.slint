import { UTCOffsetChanger } from "utc-offset-changer.slint";
import { NameChange } from "name-change.slint";
import { CancelAndSave } from "cancel-and-save.slint";
import { ClockGlobals, ClockData } from "@seeds-clock/ui/clock/globals.slint";

export component TouchBlock {
	width: 500px;
	height: 500px;
	
	Rectangle {
		background: black;
		opacity: 0.25;
	}

	TouchArea {}
}

export component ClockDataChanger {
	visible: true;

	width: 200px;
	height: 125px;


	rectangle := Rectangle {
		background: #E851BE;

		border-radius: 32px;
	}


	name-change := NameChange {
		y: 10px;
		size: 1.0;

		background: #C732AE;

		private property <string> previous-name: self.text;
		changed text => {
			if ClockGlobals.exceeds-character-limit(self.text) {
				self.text = self.previous-name;
			}
			else {
				self.previous-name = self.text;
			}
		}
	}

	utc-offset-changer := UTCOffsetChanger {
		preview-mode: ClockGlobals.preview-mode;

		y: 42.5px;
		size: 1.2;

		hours-offset-scroll <=> ClockGlobals.hours-offset-scroll;
		minutes-offset-scroll <=> ClockGlobals.minutes-offset-scroll;
	}	

	callback exit();
	callback save-error(clock-name: string);
	cancel-and-save := CancelAndSave {
		y: 95px;
		size: 0.9;

		cancel => {
			root.visible = false;
			root.exit();
		}

		private property <int> clock-index: -1;
		save => {
			if ClockGlobals.has-clock(name-change.text) {
				root.save-error(name-change.text);
				return;
			}

			let clock-name = name-change.text;
			let hours-offset = utc-offset-changer.get-hours-offset();
			let minutes-offset = utc-offset-changer.get-minutes-offset();

			let index = self.clock-index;
			let clock-data = ClockGlobals.clock-data-new(
				clock-name, hours-offset, minutes-offset
			);

			ClockGlobals.save-clock(index, clock-data);
			root.visible = false;
			root.exit();
		}
	}


	public function set-clock-index(index: int) {
		cancel-and-save.clock-index = index;

		if index == -1 {
			name-change.text = "New Clock";
			name-change.previous-name = name-change.text;

			utc-offset-changer.set-indexes-at-offset(0, 0);
			return;
		}

		let clock-data = ClockGlobals.clock-list[index];

		name-change.text = clock-data.name;
		name-change.previous-name = name-change.text;

		utc-offset-changer.set-indexes-at-offset(
			clock-data.hours-offset, clock-data.minutes-offset,
		);
	}
}