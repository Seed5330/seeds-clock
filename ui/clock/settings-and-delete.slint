component ButtonWithImage {
	width: 100px;
	height <=> root.width;



	in property <image> image <=> image.source;
	in property <brush> colorize <=> image.colorize;

	image := Image {
		width: 100%;
		height: 100%;

		image-rendering: pixelated;

		colorize: white;
	}



	callback clicked <=> touch-area.clicked;
	touch-area := TouchArea {
		mouse-cursor: pointer;
	}
}


export component SettingsAndDelete {
	width: 500px;
	height: 50px;



	callback delete <=> delete.clicked;
	callback settings <=> settings.clicked;

	HorizontalLayout {
		alignment: space-between;
		cross-axis-alignment: center;



		delete := ButtonWithImage {
			height <=> root.height;

			image: @image-url("@seeds-clock/assets/trash_bin.png");
			colorize: red;
		}

		settings := ButtonWithImage {
			height <=> root.height;

			image: @image-url("@seeds-clock/assets/settings.png");
			colorize: darkgrey;
		}
	}
}
