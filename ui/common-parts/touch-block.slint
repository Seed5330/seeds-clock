export component TouchBlock {
	width: 1280px;
	height: 720px;
	
	rectangle := Rectangle { background: black; opacity: 1; }
	TouchArea {}

	public function set-opacity(opacity: float) {
		if opacity == 0.0 {
			self.visible = false;
		}
		else {
			self.visible = true;
		}

		rectangle.opacity = opacity;
	}

	@children
}