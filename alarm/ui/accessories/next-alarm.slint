import { AlarmGlobals } from "@alarm/globals.slint";
import { TextWithBackround } from "@helpers/helpers.slint";


export component NextAlarm {
	width: 300px;
	height: 36px;

	in-out property <int> hour: 12;
	in-out property <int> minute: 30;


	text-with-background := TextWithBackround {
		width: 100%;
		height: 100%;

		text: root.next-alarm-display();
		background: #E0704C;
		border-radius: 16px;
	}
	
	pure function next-alarm-display() -> string {
		"Next Alarm: " +
			"Tue" +
			"  |  " +
			root.time-display(root.hour, root.minute)
	}


	pure function time-display(hour: int, minute: int) -> string {
		AlarmGlobals.time-display(hour, minute)
	}

	public pure function matches-time(hour: int, minute: int) -> bool {
		if hour == root.hour && minute == root.minute { return true; }
		else { return false; }
	}
}