import { TextWithBackround, CommonText, ButtonText } from "@helpers/helpers.slint";

component SnoozeOrDismiss {
	width: 300px;
	height: 30px;


	callback dismiss <=> dismiss.clicked;
	callback snooze <=> snooze.clicked;

	HorizontalLayout {
		alignment: space-between;
		cross-axis-alignment: center;
		
		dismiss := ButtonText {
			width: 100px;

			text: "Dismiss";
			font-size: root.height - 10px;
			background: #FF7552;
		}
		snooze := ButtonText {
			width: dismiss.width;

			text: "Snooze";
			font-size: root.height - 10px;
			background: #FF491A;
		}
	}
}

export component Notification {
	width: 300px;
	height: 180px;

	Rectangle {
		background: #805050;
		border-radius: 16px;
	}

	alarm-name := TextWithBackround {
		y: 10px;

		text: "Alarm Name";
		font-size: 28px;
		border-radius: 8px;

		background: #FF9C36;
	}

	time-display := CommonText {
		y: 50px;

		text: "00:00";
		font-size: 72px;
	}

	callback snooze();
	callback dismiss();
	callback clicked();
	SnoozeOrDismiss {
		y: 140px;
		width: 250px;

		dismiss => {
			root.dismiss();
			root.clicked();
		}
		snooze => {
			root.snooze();
			root.clicked();
		}
	}

	@children
}