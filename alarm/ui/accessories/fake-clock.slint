import { CommonText } from "@helpers/helpers.slint";
import { AlarmGlobals } from "../globals.slint";
export component FakeClock {
	width: common-text-style.width * 1.25;
	height: 36px;

	in property <brush> background <=> rectangle.background;
	rectangle := Rectangle {
		background: yellow;
	}


	in-out property <int> hour: 11;
	in-out property <int> minute: 55;

	common-text-style := CommonText {
		text: AlarmGlobals.time-display(hour, minute);
		font-size: root.height / 1.5;
	}

	Timer {
		running: true;
		interval: 1000ms;

		triggered => {
			root.minute += 1;

			if root.minute == 60 {
				root.minute = 0;
				hour += 1;
			}
			if root.hour == 24 {
				root.hour = 0;
			}
		}
	}


	@children
}
