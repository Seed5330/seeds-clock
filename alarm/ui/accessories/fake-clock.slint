import { CommonText } from "@helpers/helpers.slint";
import { AlarmGlobals } from "../globals.slint";

export component FakeClock {
	width: 250px;
	height: 36px;

	in property <brush> background <=> rectangle.background;
	rectangle := Rectangle {
		background: yellow;
	}


	in-out property <int> hour: 12;
	in-out property <int> minute: 25;

	common-text := CommonText {
		text: "Tue  |  " + root.time-display(root.hour, root.minute);
		font-size: root.height / 1.5;
	}

	pure function time-display(hour: int, minute: int) -> string {
		AlarmGlobals.time-display(hour, minute)
	}

	@children
}
