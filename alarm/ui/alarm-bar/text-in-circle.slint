export component TextInCircle {
	in property <float> size: 1.0;
	
	width: 50px * root.size;
	height <=> self.width;

	in property <brush> background <=> rectangle.background;
	rectangle := Rectangle {
		background: orange;
		border-radius <=> self.width;
	}

	in-out property <string> text <=> common-text-style.text;
	common-text-style := Text {
		width: 100%;
		height: 100%;

		text: "W";

		font-size: 30px * root.size;
		font-family: "Roboto";

		horizontal-alignment: center;
		vertical-alignment: center;

		stroke: black;
		stroke-width: 2px;
	}

	@children
}