import { AlarmData, Time } from "structs.slint";

export global AlarmGlobals {
	in-out property <bool> preview-mode: true;

	pure callback backend-time-display(hour: int, minute: int) -> string;
	public pure function time-display(hour: int, minute: int) -> string {
		if root.preview-mode {
			return hour + "h " + minute + "m";
		}

		backend-time-display(hour, minute)
	}

	in-out property <[string]> hour-scroll: [
		"H", "O", "U", "R", "S", "C", "R", "O", "L", "L"
	];

	in-out property <[string]> minute-scroll: [
		"M", "I", "N", "U", "T", "E", "S", "C", "R", "O", "L", "L"
	];


	callback find-next-alarm() -> Time;
	callback has-time(time: Time) -> bool;

	in-out property <[AlarmData]> alarm_list: [
		{
			name: "COUNTERSCOUNTERS", toggled: true,
			time: { hour: 12, minute: 30, },
			schedule: [true, true, true, true, true, false, false],
		},
		{
			name: "Number Two", toggled: true,
			time: { hour: 2, minute: 20, },
			schedule: [false, true, false, true, false, false, false],
		},
		{
			name: "Treason", toggled: true,
			time: { hour: 3, minute: 30, },
			schedule: [true, true, false, true, true, true, true],
		},
		{
			name: "BLANK", toggled: false,
			time: { hour: 0, minute: 0, },
			schedule: [false, false, false, false, false, false, false],
		},
		{
			name: "FIVEMAN", toggled: true,
			time: { hour: 5, minute: 5, },
			schedule: [true, true, true, true, true, false, false],
		},
		{
			name: "Sixth Ranger", toggled: true,
			time: { hour: 6, minute: 30, },
			schedule: [false, false, false, false, true, false, false],
		},
		{
			name: "Slanted Angle", toggled: true,
			time: { hour: 7, minute: 20, },
			schedule: [false, true, false, false, false, false, true],
		},		
		{
			name: "Eight Ball", toggled: true,
			time: { hour: 8, minute: 40, },
			schedule: [true, false, true, true, false, false, false],
		},
		{
			name: "Kyu", toggled: true,
			time: { hour: 9, minute: 15, },
			schedule: [false, false, true, false, false, true, false],
		},
		{
			name: "THE END", toggled: false,
			time: { hour: 23, minute: 55, },
			schedule: [false, false, false, false, false, false, true],
		},			
	];
}

