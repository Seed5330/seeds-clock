import { AlarmGlobals, AlarmData } from "globals.slint";
import { ColoredYScroll } from "@helpers/helpers.slint";
import { AlarmBar } from "alarm-bar/alarm-bar.slint";
import { NewAlarm } from "alarm-bar/new-alarm.slint";


export component AlarmScroll {
	width <=> colored-y-scroll.width;
	height <=> colored-y-scroll.height;

	private property <bool> preview-mode: AlarmGlobals.preview-mode;

	alarm-bar := AlarmBar {
		visible: false;

		name: "COUNTERSCOUNTERS";
		time-display: "00:00";
		schedule: [true, false, true, false, true, true, true];
		toggled: true;
	}	
	
	callback settings(index: int);
	colored-y-scroll := ColoredYScroll {
		width <=> alarm-bar.width;
		
		background: transparent;
		element-height <=> alarm-bar.height;
		show-count: 8;

		spacing: 0px;

		for alarm[i] in AlarmGlobals.alarm_list: AlarmBar {
			size: 1;

			private property <int> hour: alarm.hour;
			private property <int> minute: alarm.minute;

			name <=> alarm.name;
			schedule <=> alarm.schedule;
			toggled <=> alarm.toggled;

			time-display: root.get-time-display(self.hour, self.minute);
			

			settings => {
				root.settings(i);
			}

			toggle => {
				if self.toggled {
					alarm.toggled = false;
				}
				else {
					alarm.toggled = true;
				}
			}
		}

		new-alarm := NewAlarm {
			clicked => {
				root.settings(-1);
			}
		}
	}

	pure function get-time-display(hour: int, minute: int) -> string {
		if root.preview-mode {
			return hour + "-" + minute;
		}

		AlarmGlobals.backend-time-display(hour, minute)
	}
}