import "@assets/fonts/roboto/Roboto-VariableFont_wdth,wght.ttf";

import { HelpersGlobals, FakeTabSwitch, TouchBlock } from "@helpers/helpers.slint";
import { TimeDisplay, ErrorMessage } from "accessories/accessories.slint";

import { ClockDataChanger } from "clock-data-changer/clock-data-changer.slint";
import { ClocksScroll } from "clocks-scroll.slint";


import { ClockGlobals, ClockData, ClockNameValidity } from "globals.slint";
export { ClockGlobals, ClockData, ClockNameValidity }


export component Clock {
	width: HelpersGlobals.window-width;
	height: HelpersGlobals.window-height;

	rectangle := Rectangle { background: #A622E3; }


	time-display := TimeDisplay {
		y: 100px;

		background: #891599;
		interactive: false;

		private property <ClockData> clock-data <=> ClockGlobals.local-clock;
		name: clock-data.name;
		utc-offset: {
			hours-offset: self.clock-data.hours-offset,
			minutes-offset: self.clock-data.minutes-offset,
		};
	}


	ClocksScroll {
		y: 330px;

		settings(index) => {
			clock-data-changer.set-clock-index(index);
			clock-data-changer.toggle(true);
		}
	}


	touch-block := TouchBlock {
		visible: false;

		width: 100%;
		height: 100%;

		opacity: 0.5;
	}

	clock-data-changer := ClockDataChanger {
		visible: false;

		error-message(message) => {
			error-message.text = message;
			error-message.toggle(true);
		}

		exit => {
			error-message.toggle(false);
			self.toggle(false)
		}

		function toggle(enabled: bool) {
			self.visible = enabled;
			touch-block.visible = enabled;
		}
	}

	error-message := ErrorMessage {
		y: 440px;

		opacity: 0;

		private property <bool> animated: false;
		animate opacity {
			enabled: self.animated;
			easing: ease-in-sine;

			delay: 2s;
			duration: 3s;
		}

		function toggle(enabled: bool) {
			if enabled {
				error-message.animated = false;
				error-message.opacity = 1.0;

				error-message.animated = true;
				error-message.opacity = 0.0;
			}
			else {
				error-message.animated = false;
				error-message.opacity = 0.0;
			}
		}
	}


	FakeTabSwitch { y: 0px; }
}
