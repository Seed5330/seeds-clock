export struct ClockData {
	name: string,
	hours-offset: int,
	minutes-offset: int,
}

export enum ClockNameValidity {
	Valid,
	Empty,
	Exceeds16Characters,
	HasEmoji,
	Duplicate,
}

export global ClockGlobals {
	in-out property <bool> preview-mode: true;
	in-out property <int> ticks-elapsed: 0;

	in-out property <[string]> hours-offset-scroll: [
		"+00", "+01", "+02", "+03", "+04", "+05", "+06", "+07", "+08", "+09",
	];
	in-out property <[string]> minutes-offset-scroll: [
		"00", "01", "02", "03", "04", "05", "06", "07", "08", "09",
	];

	


	in-out property <ClockData> local-clock: { name: "Local Clock", hours-offset: 1, minutes-offset: 0 };

	in-out property <[ClockData]> clock-list: [
		{ name: "ACKNOWLEDGEMENTS", hours-offset: 0, minutes-offset: 0 },
		{ name: "Nudged", hours-offset: -1, minutes-offset: 0 },
		{ name: "Half Way", hours-offset: 6, minutes-offset: 0 },
		{ name: "Negative", hours-offset: -10, minutes-offset: 0 },
		{ name: "End Point", hours-offset: 12, minutes-offset: 0 },
	];

	
	pure callback backend-utc-offset-display(hour: int, minute: int) -> string;
	public pure function utc-offset-display(hour: int, minute: int) -> string {
		if root.preview-mode {
			return hour + "h " + minute + "m";
		}
		
		root.backend-utc-offset-display(hour, minute)
	}

	pure callback backend-utc-now(hours-offset: int, minutes-offset: int) -> string;
	public pure function utc-now(hours-offset: int, minutes-offset: int) -> string {
		if root.preview-mode {
			return hours-offset + "h " + minutes-offset + "m 0s";
		}
		
		root.backend-utc-now(hours-offset, minutes-offset)
	}

	pure callback is-valid-clock-name(clock-name: string) -> ClockNameValidity;
	pure callback has-clock-name(clock-name: string) -> bool;
}