import { ColoredYScroll } from "@helpers/helpers.slint";
import { ClockGlobals, ClockData } from "globals.slint";
import { TimeDisplay, NewClock } from "accessories/accessories.slint";

export component ClocksScroll {
	width: clock-in-layout.width * 1.2;

	height: self.set-height();
	pure function set-height() -> length {
		let clocks-count = 3;
		let clocks-height-pixels = clock-in-layout.height * clocks-count;
		let layout-spacing-pixels = colored-y-scroll.spacing * (clocks-count + 1);

		clocks-height-pixels + layout-spacing-pixels
	}

	private property <int> ticks <=> ClockGlobals.ticks-elapsed;

	
	clock-in-layout := TimeDisplay {
		visible: false;

		size: 0.6;
		// width
		// height

		background: #A037BF;
	}


	callback settings(index: int);
	colored-y-scroll := ColoredYScroll {
		width: 100%;
		height: 100%;

		background: #9831A3;
		border-radius: 16px;

		private property <[ClockData]> clocks <=> ClockGlobals.clock-list;
		for clock[i] in self.clocks: TimeDisplay {
			size <=> clock-in-layout.size;
			background: clock-in-layout.background;

			name: clock.name;
			utc-offset: {
				hours-offset: clock.hours-offset,
				minutes-offset: clock.minutes-offset,
			};

			clicked => {
				root.settings(i);
			}
		}

		Rectangle {
			width: clock-in-layout.width;
			height: clock-in-layout.height;

			background: clock-in-layout.background;
			border-radius: clock-in-layout.border-radius;

			NewClock {
				size: 0.9;
				background: #D272E8;

				clicked => {
					root.settings(-1);
				}
			}
		}
	}

	pure function utc-now(hours-offset: int, minutes-offset: int, ticks: int) -> string {
		ClockGlobals.utc-now(hours-offset, minutes-offset)
	}
}
