import { UTCOffsetChanger } from "utc-offset-changer.slint";
import { NameChange } from "name-change.slint";
import { ConfirmButtons } from "confirm-buttons.slint";
import { ClockGlobals, ClockData, ClockNameValidity } from "../globals.slint";

export component ClockDataChanger {
	visible: true;

	width: 300px;
	height: 200px;


	rectangle := Rectangle {
		background: #E851BE;

		border-radius: 32px;
	}


	private property <int> clock-index: -1;
	private property <[ClockData]> clock-list <=> ClockGlobals.clock-list;


	name-change := NameChange {
		y: 15px;
		size: 1.2;

		background: #C732AE;
	}

	utc-offset-changer := UTCOffsetChanger {
		preview-mode: ClockGlobals.preview-mode;

		y: 60px;
		size: 2;

		width: 180px;

		hours-offset-scroll <=> ClockGlobals.hours-offset-scroll;
		minutes-offset-scroll <=> ClockGlobals.minutes-offset-scroll;
	}	

	callback exit();
	callback error-message(message: string);
	confirm-buttons := ConfirmButtons {
		y: 155px;
		size: 1;

		delete => {
			if root.clock-index != -1 {
				root.clock-list.remove(root.clock-index);
				root.exit();
			}
		}

		cancel => {
			root.exit();
		}

		save => {
			let index = root.clock-index;
			let clock-data = {
				name: name-change.text,
				hours-offset: utc-offset-changer.hours-offset(),
				minutes-offset: utc-offset-changer.minutes-offset(),
			};


			let clock-name-validity = root.is-valid-clock-name(clock-data.name);

			if clock-name-validity == Empty {
				root.error-message("Please enter a clock name.");
				return;
			}
			if clock-name-validity == HasEmoji {
				root.error-message("Clock name cannot have emojis.");
				return;
			}
			if clock-name-validity == Duplicate {
				root.error-message("Clock with the name '" + clock-data.name + "' already exists.");
				return;
			}

			
			if index == -1 {
				root.clock-list.push(clock-data);
			}
			else {
				root.clock-list[index] = clock-data;
			}

			root.exit();
		}
	}


	pure function is-valid-clock-name(clock-name: string) -> ClockNameValidity {
		if ClockGlobals.has-clock-name(clock-name) {
			return Duplicate;
		}
		else {
			return ClockGlobals.is-valid-clock-name(clock-name);
		}
	}


	public function set-clock-index(index: int) {
		root.clock-index = index;

		if index == -1 {
			name-change.try_set_text("New Clock");
			utc-offset-changer.set-utc-offset(0, 0);
			return;
		}

		let clock-data = root.clock-list[index];

		name-change.try_set_text(clock-data.name);
		utc-offset-changer.set-utc-offset(
			clock-data.hours-offset, clock-data.minutes-offset,
		);
	}
}