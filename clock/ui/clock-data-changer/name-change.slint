export component NameChange {
	in property <float> size: 1.0;

	width: 200px * root.size;
	height: 24px * root.size;
	

	in property <brush> background <=> rectangle.background;
	rectangle := Rectangle {
		background: red;
	}


	out property <string> text <=> text.text;
	text := Text {
		width <=> root.width;

		text: "JAKQJAKQJAKQJAKQ";
		color: black;

		font-size: 16px * root.size;
		font-family: "Roboto";

		horizontal-alignment: center;
		vertical-alignment: center;

		stroke: self.color;
		stroke-width: 2px;
	}

	text-input := TextInput {
		width <=> text.width;
		
		text: "JAKQJAKQJAKQJAKQ";
		color: white;

		font-size <=> text.font-size;
		font-family <=> text.font-family;

		horizontal-alignment <=> text.horizontal-alignment;
		vertical-alignment <=> text.vertical-alignment;

		changed text => {
			root.try_set_text(self.text);
		}
	}

	public function try_set_text(str: string) {
		if str.character-count > 16 {
			// Text component has previous text
			text-input.text = text.text;
		}
		else {
			text-input.text = str;
			text.text = str;
		}
	}
}