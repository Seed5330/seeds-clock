import "@assets/fonts/roboto/Roboto-VariableFont_wdth,wght.ttf";

import { HelpersGlobals } from "@helpers/helpers.slint";





import { Clock, ClockGlobals, ClockData, ClockNameValidity } from "@clock/clock.slint";
import { Alarm, AlarmGlobals, AlarmData, Time as AlarmTime } from "@alarm/alarm.slint";
import { Stopwatch } from "@stopwatch/stopwatch.slint";
import { Timer as CountTimer } from "@timer/timer.slint";
import { TabSwitch } from "tab-switcher.slint";

export {
	HelpersGlobals,
	ClockGlobals, ClockData as SpClockData, ClockNameValidity as SpClockNameValidity,
	AlarmGlobals, AlarmData as SpAlarmData, AlarmTime as SpAlarmTime,
}






export component SlintProgram inherits Window {
	title: "Slint Program";

	width: 1200px;
	height: (root.width / 16) * 9;

	background: lightgray;


	in-out property <int> active-tab: 0;
	
	clock := Clock { visible: root.active-tab == 0; }
	alarm := Alarm { visible: root.active-tab == 1; }
	stopwatch := Stopwatch { visible: root.active-tab == 2; }
	count-timer := CountTimer { visible: root.active-tab == 3;}


	private property <[{name: string, color: brush}]> tab-switchers: [
		{name: "Clock", color: #A622E3},
		{name: "Alarm", color: #F59D47},
		{name: "Stopwatch", color: #120059},
		{name: "Timer", color: #27D8F5},
	];


	HorizontalLayout {
		alignment: center;

		for tab[i] in tab-switchers: TabSwitch {
			name: tab.name;
			color: tab.color;

			clicked => {
				root.active-tab = i;
			}
		}
	}
}
