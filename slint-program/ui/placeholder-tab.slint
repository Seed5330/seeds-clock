export component PlaceholderTab {
	width: 1200px;
	height: 675px;


	in property <brush> background <=> rectangle.background;
	rectangle := Rectangle {
		background: yellow;
	}


	in property <string> text <=> text.text ;
	text := Text {
		text: "NAME";

		font-size: 64px;
		font-family: "Roboto";

		stroke: black;
		stroke-width: 2px;

		horizontal-alignment: center;
		vertical-alignment: center;
	}
}
